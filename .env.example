# Backend API root. The code reads VITE_BASE_URL (Vite only exposes VITE_* vars
# to the browser), so the name must keep the prefix.
VITE_BASE_URL=""

# Supabase project. The anon key is safe to ship in the client bundle ONLY as
# long as row level security actually restricts what `anon` can do -- see
# ../care-connect-crm-frontend-main/supabase/migrations for the policies.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
